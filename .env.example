# Copy this file to .env and fill in real values. .env itself is
# gitignored — never commit real secrets.

OPENAI_API_KEY=

SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_SHOP=

EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_ENV=
EBAY_MARKETPLACE=

# Supabase project — Settings -> API in the Supabase dashboard.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Service-role key: full admin access, bypasses Row Level Security.
# Only needed for import_vintage_corrections.py — never used by the
# app itself during normal use, never send this to a browser.
SUPABASE_SERVICE_ROLE_KEY=
